{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="form-container">
        <img class="logo" src="{{ asset('img/logo_forge-chene.png') }}" alt="Logo Forge & Chêne">
        <div class="divider"></div>
        <div class="routes">
            <a class="selected" href="{{ path('app_login') }}"><span class="material-symbols-outlined">key</span>Connexion</a>
            <a class="" href="{{ path('app_register') }}"><span class="material-symbols-outlined">construction</span>Créer un compte</a>
        </div>
        <div class="login-form-container">
            <h1 class="h3">Authentification</h1>
            <h2>Accéder à votre compte</h2>
            <h3>Gérez vos commandes et votre compte</h3>
            <form method="post" novalidate>
                {% if error %}
                    <div class="form-errors"><ul><li>Email ou mot de passe incorrect.</li></ul></div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
                    </div>
                {% endif %}

                <div class="form-group"> 
                <label class="form-label" for="username">Email</label>
                <input class="form-input" type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>
                </div>
                <div class="form-group">
                <label class="form-label" for="password">Mot de passe</label>
                <input class="form-input" type="password" name="_password" id="password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="checkbox mb-3">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Remember me</label>
                    </div>
                #}

                <button class="btn" type="submit">
                    Se connecter
                </button>
            </form>
        </div>
        <div class="back-to-products-container">
            <a class="back-to-products" href="{{ path('app_home') }}#products"><span class="material-symbols-outlined">arrow_back</span>Retour aux produits</a>
        </div>
    </div>
{% endblock %}
