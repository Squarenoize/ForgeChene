{% extends 'base-auth.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    
    <div class="registration-form-container"> 
        <h1>Inscription</h1>
        <h2>Créer un compte</h2>
        <h3>Veuillez remplir le formulaire ci-dessous pour créer votre compte.</h3>

        {{ form_start(registrationForm, { attr: { novalidate: 'novalidate' } }) }}
            <div class="form-group">
                {{ form_label(registrationForm.firstname, 'Prénom', { label_attr: { class: 'form-label' } }) }}
                {% if form_errors(registrationForm.firstname) %}
                    {{ form_errors(registrationForm.firstname) }}
                {% endif %}
                {{ form_widget(registrationForm.firstname, { attr: { class: 'form-input' } }) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.lastname, 'Nom', { label_attr: { class: 'form-label' } }) }}
                {% if form_errors(registrationForm.lastname) %}
                    {{ form_errors(registrationForm.lastname) }}
                {% endif %}
                {{ form_widget(registrationForm.lastname, { attr: { class: 'form-input' } }) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.email, 'Adresse email', { label_attr: { class: 'form-label' } }) }}
                {% if form_errors(registrationForm.email) %}
                    {{ form_errors(registrationForm.email) }}
                {% endif %}
                {{ form_widget(registrationForm.email, { attr: { class: 'form-input' } }) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.plainPassword.first, 'Mot de passe', { label_attr: { class: 'form-label' } }) }}
                {% if form_errors(registrationForm.plainPassword.first) %}
                    {{ form_errors(registrationForm.plainPassword.first) }}
                {% endif %}
                {{ form_widget(registrationForm.plainPassword.first, { attr: { class: 'form-input' } }) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.plainPassword.second, 'Confirmez le mot de passe', { label_attr: { class: 'form-label' } }) }}
                {% if form_errors(registrationForm.plainPassword.second) %}
                    {{ form_errors(registrationForm.plainPassword.second) }}
                {% endif %}
                {{ form_widget(registrationForm.plainPassword.second, { attr: { class: 'form-input' } }) }}
            </div>
            <div class="condition-group">
                {{ form_widget(registrationForm.agreeTerms) }}
                {{ form_label(registrationForm.agreeTerms, 'J\'accepte les termes et conditions d\'utilisation', { label_attr: { class: 'form-label' } }) }}
                {% if form_errors(registrationForm.agreeTerms) %}
                    {{ form_errors(registrationForm.agreeTerms) }}
                {% endif %}
            </div>

            <button type="submit" class="btn">S'inscrire</button>
        {{ form_end(registrationForm) }}

        <div class="api-message">
        <h4><span class="material-symbols-outlined">dataset</span> API produits de Forge & Chêne</h4>
        <p>Votre compte donne accès direct aux produits  (B2B) si vous faites une demande  de clé d'API catalogue.</p>
        </div>
    </div>
    
{% endblock %}
