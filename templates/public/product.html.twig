{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}

<section class="product-container">
    <div class="product-image-container"> 
        <img src="{{ asset(product.photoPath) }}" alt="{{ product.name }}">
    </div>
    <div class="product-details">
        <p class="reference">REF : {{ product.reference }}</p>
        <h1 class="product-name">{{ product.name }}</h1>
        <h2 class="short-description">{{ product.shortDescription }}</h2>
        <div class="row">
            <div class="price-container">
                <p class="price">{{ product.price }} €</p>
                <p class="tax-info">TVA incluse - FRANCE</p>
            </div>
            <p class="monthly-payment">
                <span class="material-symbols-outlined">payments</span> 
                ou 4 mensualités de <span class="monthly-amount">{{ (product.price / 4)|number_format(2, ',', ' ') }} €</span> sans frais
            </p>
            <p class="delivery-info">
                <span class="material-symbols-outlined">local_shipping</span>
                Livraison à domicile incluse
            </p>
        </div>
        <div class="row">
            <p class="description-title"><i class="icon-description"></i> Description</p>
            <p class="description-content">{{ product.description }}</p>
        </div>
        <div class="row stock-content">
            <div class="stocks">
                <div class="stock-indicator green"></div>
                <div class="stock-text">
                    <p class="stock-status">En stock à l'atelier</p>
                    <p class="delivery">Expédition sous 7 à 10 jours ouvrés</p>
                </div>
            </div>
            <div class="stock-quantity">
                <p>{{ product.stockQuantity }} <br>RESTANTS</p>
            </div>
        </div>
        <div class="actions">
            <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
                <input type="hidden" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                <div class="quantity-selector" data-controller="quantity">
                    <button type="button" class="decrease-quantity" data-action="quantity#decrease">-</button>
                    <input type="text" class="quantity" name="quantity" value="1" min="1" max="{{ product.stockQuantity }}" data-quantity-target="input">
                    <button type="button" class="increase-quantity" data-action="quantity#increase">+</button>
                </div>
                <button type="submit" class="add-to-cart"><span class="material-symbols-outlined">shopping_cart</span> AJOUTER AU PANIER</button>
            </form>
        </div>
    </div>
</section>

{% endblock %}