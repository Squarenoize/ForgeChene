{% extends 'base.html.twig' %}

{% block title %}Mon Compte{% endblock %}

{% block body %}

    <div class="account-container">
        <h1>Mon Compte</h1>
        <p>{{ user.firstName }} {{ user.lastName }}</p>
        <div class="account-actions">
            <a href="#"><span class="material-symbols-outlined">terminal</span>Activer mon accès API</a>
            <a href="#"><span class="material-symbols-outlined">key</span>Voir ma clé API</a>
            <a href="#"><span class="material-symbols-outlined">person</span>Profil et adresse de livraison</a>
            <a href="#"><span class="material-symbols-outlined">shield_with_heart</span>Supprimer mon compte</a>
        </div>
    </div>
    <div class="orders-container">
        <h2 class="my-orders">Mes Commandes</h2>
        <div class="orders-cards">
            <div class="order-card">
                <div class="order-details">
                    <div class="order-info">
                        <div>
                            <p class="label">Commande n°</p>
                            <p class="value number">12345</p>
                        </div>
                        <div>
                            <p class="label">Date</p>
                            <p class="value">01/01/2024</p>
                        </div>
                        <div>
                            <p class="label">Statut</p>
                            <p class="value">En cours</p>
                        </div>
                    </div>
                    <div class="order-total">
                        <p class="label">Total</p>
                        <p class="value">100€</p>
                    </div>
                </div>
                <div class="order-item">
                    <div class="item-container">
                        <div class="item">
                            <img src=" {{ asset('products/bourbonnais.png') }}" alt="Nom du produit">
                            <div class="item-description">
                                <p class="name">Article: Nom du produit</p>
                                <p class="short-description">Description du produit</p>
                            </div>
                        </div>
                    </div>
                    <div class="item-quantity">
                        <p class="quantity">Qté: 2</p>
                        <p class="price">50€</p>
                    </div>
                </div>
                <div class="warranty">
                    <p>Garantie structurelle de 10 ans active jusqu'au 01/01/2034</p>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
