{% extends 'base.html.twig' %}

{% block title %}Mon Compte{% endblock %}

{% block body %}

    <div class="account-container">
        <div class="account-header">
            <div>
                <h1>Mon Compte</h1>
                <p>{{ user.firstName }} {{ user.lastName }}</p>
            </div>
            <div class="account-actions">
                {% if not user.apiKey %}
                    <a href="{{ path('app_account_api_access') }}"><span class="material-symbols-outlined">terminal</span>Activer mon accès API</a>
                {% else %}
                    <a href="{{ path('app_account_api_show') }}"><span class="material-symbols-outlined">key</span>Voir ma clé API</a>
                {% endif %}
                <a href="#"><span class="material-symbols-outlined">person</span>Profil et adresse de livraison</a>
                <form method="post" action="{{ path('app_account_delete') }}" onsubmit="return confirm('Supprimer définitivement votre compte ? Vos données personnelles seront anonymisées.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                    <button type="submit"><span class="material-symbols-outlined">shield_with_heart</span>Supprimer mon compte</button>
                </form>
            </div>
        </div>
        {% include 'public/component/alerts.html.twig' %}
    </div>
    <div class="orders-container">
        <h2 class="my-orders">Mes Commandes</h2>
        <div class="orders-cards">
            {% set statusLabels = {
                'pending': 'En attente',
                'processing': 'En préparation',
                'shipped': 'Expédiée',
                'delivered': 'Livrée',
                'cancelled': 'Annulée'
            } %}
            {% for order in orders %}
                <div class="order-card">
                    <div class="order-details">
                        <div class="order-info">
                            <div>
                                <p class="label">Commande n°</p>
                                <p class="value number">{{ order.id }}</p>
                            </div>
                            <div>
                                <p class="label">Date</p>
                                <p class="value">{{ order.orderDate|date('d/m/Y') }}</p>
                            </div>
                            <div>
                                <p class="label">Statut</p>
                                <p class="value">{{ statusLabels[order.status.value] }}</p>
                            </div>
                        </div>
                        <div class="order-total">
                            <p class="label">Total</p>
                            <p class="value">{{ order.totalAmount|number_format(2, ',', ' ') }}€</p>
                        </div>
                    </div>
                    {% for item in order.orderItems %}
                        <div class="order-item">
                            <div class="item-container">
                                <div class="item">
                                    <img src="{{ asset(item.product.photoPath) }}" alt="{{ item.product.name }}">
                                    <div class="item-description">
                                        <p class="name">Article: {{ item.product.name }}</p>
                                        <p class="short-description">{{ item.product.shortDescription }}</p>
                                    </div>
                                </div>
                            </div>
                            <div class="item-quantity">
                                <p class="quantity">Qté: {{ item.quantity }}</p>
                                <p class="price">{{ item.unitPriceAtOrder|number_format(2, ',', ' ') }}€</p>
                            </div>
                        </div>
                    {% endfor %}
                    <div class="warranty">
                        <p>Garantie structurelle de 10 ans active jusqu'au {{ order.orderDate|date_modify('+10 years')|date('d/m/Y') }}</p>
                    </div>
                </div>
            {% else %}
                <p>Vous n'avez pas encore de commande.</p>
            {% endfor %}
        </div>
    </div>

{% endblock %}
