classDiagram
    
    class User {
        -string firstname
        -string lastname
        -string email
        -string password
        -string apiKey
        -boolean conditionsAccepted
        -boolean isDeleted
        -date deletedAt
    }
    
    class Product {
        -string reference
        -string name
        -string shortDescription
        -text description
        -string photoPath
        -float price
        -int stockQuantity
    }
    
    class Cart {
        -datetime createdAt
        -datetime isDeletedAt
    }
    
    class CartItem {
        -int quantity
    }
    
    class Order {
        -string status
        -date orderDate
        -float totalAmount
    }
    
    class OrderItem {
        -int quantity
        -float UnitPriceAtOrder
    }

    class OrderStatusHistory {
        -string status
        -datetime changedAt
    }
    
    %% Relations entre classes (avec cardinalités)

    User "1" -- "0..*" Cart
    User "1" -- "0..*" Order
    Cart "1" -- "0..*" CartItem
    Product "1" -- "0..*" CartItem
    Product "1" -- "0..*" OrderItem
    Order "1" -- "1..*" OrderItem
    Order "1" -- "1..*" OrderStatusHistory